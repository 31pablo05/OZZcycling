{
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/LOGO/(.*)",
      "destination": "/LOGO/$1"
    },
    {
      "source": "/OZZimages/(.*)",
      "destination": "/OZZimages/$1"
    },
    {
      "source": "/OZZvideos/(.*)",
      "destination": "/OZZvideos/$1"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}